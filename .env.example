# Required for auth, ads and inventory
DATABASE_URL=postgresql://user:pass@host:5432/motor

# Optional — real SMS OTP via Twilio Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional — Twilio Verify (preferred if set; overrides Messaging for OTP)
TWILIO_VERIFY_SERVICE_SID=

# Admin seed (created on first DB init if missing)
ADMIN_EMAIL=admin@motor.pk
ADMIN_PASSWORD=MotorAdmin@2026

# Force Secure cookies (defaults on for Vercel / production)
# COOKIE_SECURE=true
