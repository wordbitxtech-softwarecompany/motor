# Required — prefer Supabase Session pooler on Vercel (IPv4):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Direct db.<ref>.supabase.co is IPv6-only and fails on Vercel; the app rewrites it to the pooler when possible.
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Optional — if Vercel Marketplace set these, they are preferred over DATABASE_URL
# POSTGRES_URL=
# POSTGRES_PASSWORD=
# SUPABASE_REGION=ap-northeast-2

# Optional — HMAC secret for OTP cookies (falls back to TWILIO_AUTH_TOKEN / DATABASE_URL)
# OTP_SECRET=

# Optional — real SMS OTP via Twilio Messaging
# TWILIO_PHONE_NUMBER = your Twilio sender number (one From for all users), NOT the buyer's phone
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional — Twilio Verify (preferred; no From number needed)
TWILIO_VERIFY_SERVICE_SID=

# Admin seed (created on first DB init if missing) — optional overrides
ADMIN_EMAIL=admin@motor.pk
ADMIN_PASSWORD=MotorAdmin@2026

# Force Secure cookies (defaults on for Vercel / production)
# COOKIE_SECURE=true
